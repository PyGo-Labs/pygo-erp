# ═══════════════════════════════════════════════
#  Facturas (Invoicing)
# ═══════════════════════════════════════════════

route GET /facturas -> facturas.index
route GET /facturas/create -> facturas.create
route POST /facturas -> facturas.store
route GET /facturas/{id} -> facturas.show
route POST /facturas/{id}/timbrar -> facturas.timbrar

handler facturas_store(tipo: String, folio: String, cliente_id: UUID) -> Redirect:
  factura = Factura(
    tipo: tipo,
    folio: folio,
    cliente: cliente_id,
    empresa: current_user.empresa,
  )
  factura.calcular_totales()  # Auto-calculate from lines
  factura.save()
  flash("success", "Factura creada")
  return redirect("/facturas")


# ═══════════════════════════════════════════════
#  Inventory Management
# ═══════════════════════════════════════════════

route GET /inventario -> inventario.index
route GET /inventario/bajo-stock -> inventario.bajo_stock
route POST /inventario/entrada -> inventario.entrada
route POST /inventario/salida -> inventario.salida

handler inventario_entrada(producto_id: UUID, cantidad: Decimal, almacen: String) -> Redirect:
  InventarioService.entrada(producto_id, float(cantidad), almacen)
  metrics.increment("inventory.entry", 1, {producto: str(producto_id)})
  return redirect("/inventario")


# ═══════════════════════════════════════════════
#  Sales Orders
# ═══════════════════════════════════════════════

route GET /pedidos -> pedidos.index
route GET /pedidos/create -> pedidos.create
route POST /pedidos -> pedidos.store
route GET /pedidos/{id} -> pedidos.show

handler pedidos_store(cliente_id: UUID, productos: Array[dict]) -> Redirect:
  """Create sales order from product list."""
  pedido = Pedido(
    tipo: "pedido",
    folio: f"PED-{uuid_short()}",
    cliente: cliente_id,
    empresa: current_user.empresa,
  )
  pedido.save()

  total = Decimal("0")
  for prod in productos:
    linea = PedidoLinea(
      pedido: pedido.id,
      producto: prod["producto_id"],
      cantidad: Decimal(prod["cantidad"]),
      precio_unitario: Decimal(prod["precio"]),
    )
    linea.total_linea = linea.cantidad * linea.precio_unitario
    linea.save()
    total += linea.total_linea

  pedido.total = total
  pedido.save()

  metrics.increment("sales.order_created", 1)
  return redirect(f"/pedidos/{pedido.id}")


