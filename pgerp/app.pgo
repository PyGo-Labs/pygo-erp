# ═══════════════════════════════════════════════
#  CRUD — Facturas (Invoicing)
# ═══════════════════════════════════════════════

route GET /facturas -> facturas_index
route GET /facturas/create -> facturas_create
route POST /facturas -> facturas_store
route GET /facturas/{id} -> facturas_show
route POST /facturas/{id}/timbrar -> facturas_timbrar

handler facturas_store() -> Redirect:
  factura = Factura(
    tipo: request.form.get("tipo", "venta"),
    folio: "FAC-" + gen_uuid_short(),
    cliente: request.form.get("cliente"),
    empresa: current_user.empresa,
  )
  factura.save()

  # Process line items
  for idx, prod_id in request.form.getlist("producto"):
    producto = Producto.find(prod_id)
    cantidad = Decimal(request.form.getlist("cantidad")[idx])
    FacturaLinea(
      factura: factura.id,
      producto: prod_id,
      cantidad: cantidad,
      precio_unitario: producto.precio_unitario,
      total_linea: cantidad * producto.precio_unitario,
    ).save()

  # Calculate totals
  lineas = FacturaLinea.where("factura", factura.id).all()
  factura.subtotal = sum(l.total_linea for l in lineas)
  factura.iva = factura.subtotal * Decimal("0.16")
  factura.total = factura.subtotal + factura.iva
  factura.save()

  flash("success", "Factura creada")
  return redirect("/facturas")

handler facturas_timbrar(id: UUID) -> Redirect:
  factura = Factura.find(id)
  factura.estatus = "timbrada"
  factura.save()
  log.info("Factura timbrada", folio=factura.folio)
  return redirect(f"/facturas/{id}")


# ═══════════════════════════════════════════════
#  Inventory
# ═══════════════════════════════════════════════

route GET /inventario -> inventario_index
route POST /inventario/entrada -> inventario_entrada
route POST /inventario/salida -> inventario_salida

handler inventario_index() -> HTML:
  query = Inventario.where("empresa", current_user.empresa)
  items = query.all()
  stats = {
    total_productos: count(Producto, where: {empresa: current_user.empresa}),
    stock_bajo: count(Inventario, where: {empresa: current_user.empresa, stock_actual < stock_minimo}),
    valor_total: sum(Inventario, "stock_actual * producto.precio_unitario"),
    movimientos: count(MovimientoInventario, where: {fecha__gte: days_ago(30)}),
  }
  return template("inventario/index.html", {items: items, stats: stats})

handler inventario_entrada() -> Redirect:
  producto_id = request.form["producto"]
  cantidad = Decimal(request.form["cantidad"])

  inv = Inventario.get(producto: producto_id) or Inventario(
    producto: producto_id, almacen: "default",
    empresa: current_user.empresa,
  )
  inv.stock_actual += cantidad
  inv.save()

  MovimientoInventario(
    tipo: "entrada", producto: producto_id, almacen: "default",
    cantidad: cantidad, empresa: current_user.empresa,
  ).save()

  metrics.increment("inventory.entry", 1, {producto: str(producto_id)})
  flash("success", "Entrada registrada")
  return redirect("/inventario")


# ═══════════════════════════════════════════════
#  Sales Orders
# ═══════════════════════════════════════════════

route GET /pedidos -> pedidos_index
route GET /pedidos/create -> pedidos_create
route POST /pedidos -> pedidos_store

handler pedidos_store() -> Redirect:
  pedido = Pedido(
    tipo: "pedido",
    folio: "PED-" + gen_uuid_short(),
    cliente: request.form["cliente"],
    empresa: current_user.empresa,
  )
  pedido.save()

  for idx, prod_id in request.form.getlist("producto"):
    producto = Producto.find(prod_id)
    cantidad = Decimal(request.form.getlist("cantidad")[idx])
    PedidoLinea(
      pedido: pedido.id,
      producto: prod_id,
      cantidad: cantidad,
      precio_unitario: producto.precio_unitario,
      total_linea: cantidad * producto.precio_unitario,
    ).save()

  pedido.total = sum(l.total_linea for l in PedidoLinea.where("pedido", pedido.id).all())
  pedido.save()

  flash("success", "Pedido creado")
  return redirect("/pedidos")


