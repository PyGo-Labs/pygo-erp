# ═══════════════════════════════════════════════
#  Reports
# ═══════════════════════════════════════════════

route GET /reportes/ventas -> reportes.ventas
route GET /reportes/inventario -> reportes.inventario
route GET /reportes/contabilidad -> reportes.contabilidad

handler reportes_ventas(fecha_inicio: Date, fecha_fin: Date) -> HTML:
  """Sales report between dates."""
  query = Factura.where("empresa", current_user.empresa)
  query = query.where("tipo", "venta")
  query = query.where("fecha__gte", fecha_inicio)
  query = query.where("fecha__lte", fecha_fin)

  report_data = {
    total_ventas: query.sum("total"),
    total_iva: query.sum("iva"),
    facturas: query.all(),
    by_category: query.group_by("producto.categoria").sum("total_linea"),
  }

  return template("reportes/ventas.html", report_data)


