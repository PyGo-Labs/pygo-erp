# PyGo ERP — Main Application Routes (.pgo native format)

# Models auto-imported from models.pgo
# No Python imports needed — DSL handles everything

# ═══════════════════════════════════════════════
#  Dashboard
# ═══════════════════════════════════════════════

route GET / -> dashboard

handler dashboard() -> HTML:
  empresa = current_user.empresa
  stats = {
    productos: count(Producto, where: {empresa: empresa}),
    clientes: count(Cliente, where: {empresa: empresa}),
    proveedores: count(Proveedor, where: {empresa: empresa}),
    facturas_mes: count(Factura, where: {empresa: empresa, fecha__gte: month_start()}),
    inventario_bajo: count(Inventario, where: {empresa: empresa, stock_actual < stock_minimo}),
  }

  ingresos_mes = sum(Factura, "total", where: {
    empresa: empresa, tipo: "venta", fecha__gte: month_start(),
  })

  return template("dashboard.html", {
    stats: stats,
    ingresos_mes: ingresos_mes,
  })


# ═══════════════════════════════════════════════
#  Auth Routes
# ═══════════════════════════════════════════════

route GET /login -> login_page
route POST /login -> authenticate
route POST /logout -> logout

handler login_page() -> HTML:
  if session.user_id:
    return redirect("/dashboard")
  return template("auth/login.html")

handler authenticate(email: Email, password: String) -> Redirect:
  user = Usuario.where("email", email).first()
  if user and verify_password(user.password_hash, password):
    session.set("user_id", user.id)
    log.info("Login", user=user.email)
    return redirect("/dashboard")
  flash("error", "Credenciales inválidas")
  return redirect("/login")

handler logout() -> Redirect:
  session.clear()
  return redirect("/login")


# ═══════════════════════════════════════════════
#  CRUD — Products
# ═══════════════════════════════════════════════

route GET /productos -> productos_index
route GET /productos/create -> productos_create
route POST /productos -> productos_store
route GET /productos/{id} -> productos_show
route GET /productos/{id}/edit -> productos_edit
route POST /productos/{id} -> productos_update
route POST /productos/{id}/delete -> productos_delete

handler productos_index(q: String?, page: Int = 1) -> HTML:
  query = Producto.where("empresa", current_user.empresa)
  if q:
    query = query.where("nombre__ilike", f"%{q}%")
  items = query.paginate(page, 20).all()
  pagination = {page: page, pages: query.count() // 20 + 1, total: query.count()}
  return template("productos/index.html", {
    items: items, pagination: pagination, q: q,
  })

handler productos_create() -> HTML:
  categorias = Categoria.where("empresa", current_user.empresa).all()
  return template("productos/form.html", {producto: null, categorias: categorias})

handler productos_store() -> Redirect:
  Producto(
    codigo: request.form["codigo"],
    nombre: request.form["nombre"],
    descripcion: request.form.get("descripcion"),
    precio_unitario: Decimal(request.form["precio_unitario"]),
    tipo: request.form.get("tipo", "producto"),
    categoria: request.form.get("categoria"),
    empresa: current_user.empresa,
  ).save()
  flash("success", "Producto creado")
  return redirect("/productos")

handler productos_show(id: UUID) -> HTML:
  producto = Producto.find(id)
  inventario = Inventario.get(producto: id)
  return template("productos/show.html", {producto: producto, inventario: inventario})

handler productos_edit(id: UUID) -> HTML:
  producto = Producto.find(id)
  categorias = Categoria.where("empresa", current_user.empresa).all()
  return template("productos/form.html", {producto: producto, categorias: categorias})

handler productos_update(id: UUID) -> Redirect:
  producto = Producto.find(id)
  producto.codigo = request.form["codigo"]
  producto.nombre = request.form["nombre"]
  producto.descripcion = request.form.get("descripcion")
  producto.precio_unitario = Decimal(request.form["precio_unitario"])
  producto.save()
  flash("success", "Producto actualizado")
  return redirect("/productos")

handler productos_delete(id: UUID) -> Redirect:
  Producto.find(id).delete()
  flash("info", "Producto eliminado")
  return redirect("/productos")


