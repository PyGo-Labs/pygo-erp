# ═══════════════════════════════════════════════
#  Projects & Tasks (Kanban)
# ═══════════════════════════════════════════════

route GET /proyectos -> proyectos_index
route GET /proyectos/{id}/tareas -> proyectos_tareas

handler proyectos_index() -> HTML:
  proyectos = Proyecto.where("empresa", current_user.empresa).all()
  return template("proyectos/kanban.html", {proyectos: proyectos})

handler proyectos_tareas(id: UUID) -> HTML:
  proyecto = Proyecto.find(id)
  tareas = Tarea.where("proyecto", id).all()

  # Group by status for Kanban
  columns = ["pendiente", "en_progreso", "completado"]
  tareas_por_estatus = {}
  for col in columns:
    tareas_por_estatus[col] = [t for t in tareas if t.estatus == col]

  return template("tareas/kanban.html", {proyecto: proyecto, tareas_por_estatus: tareas_por_estatus})


# ═══════════════════════════════════════════════
#  Reports
# ═══════════════════════════════════════════════

route GET /reportes/ventas -> reportes_ventas

handler reportes_ventas(inicio: Date?, fin: Date?) -> HTML:
  query = Factura.where("empresa", current_user.empresa)
  query = query.where("tipo", "venta")
  if inicio:
    query = query.where("fecha__gte", inicio)
  if fin:
    query = query.where("fecha__lte", fin)

  facturas = query.all()
  report = {
    total_ventas: sum(f.total for f in facturas),
    total_iva: sum(f.iva for f in facturas),
    total_facturas: len(facturas),
  }

  return template("reportes/ventas.html", {report: report, facturas: facturas})


# ═══════════════════════════════════════════════
#  Settings
# ═══════════════════════════════════════════════

route GET /configuracion -> config_index
route POST /configuracion -> config_store

handler config_index() -> HTML:
  config = Configuracion.get_all(where: {empresa: current_user.empresa})
  return template("configuracion/index.html", {config: config})

handler config_store() -> Redirect:
  for key, value in request.form.items():
    Configuracion.set(key, value, empresa=current_user.empresa)
  flash("success", "Configuración guardada")
  return redirect("/configuracion")


# ═══════════════════════════════════════════════
#  API Endpoints
# ═══════════════════════════════════════════════

route GET /api/productos -> api_productos
route GET /api/facturas -> api_facturas
route GET /api/inventario -> api_inventario

handler api_productos(page: Int = 1, limit: Int = 50) -> JSON:
  query = Producto.where("empresa", current_user.empresa)
  items = query.paginate(page, limit).all()
  return [
    {id: p.id, codigo: p.codigo, nombre: p.nombre, precio: float(p.precio_unitario)}
    for p in items
  ]

handler api_facturas() -> JSON:
  facturas = Factura.where("empresa", current_user.empresa).all()
  return [
    {folio: f.folio, tipo: f.tipo, total: float(f.total), estatus: f.estatus}
    for f in facturas
  ]
