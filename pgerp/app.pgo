# ═══════════════════════════════════════════════
#  API Endpoints (REST)
# ═══════════════════════════════════════════════

route GET /api/productos -> api.productos
route GET /api/facturas -> api.facturas
route GET /api/inventario -> api.inventario

handler api_productos(page: Int = 1, limit: Int = 50) -> JSON:
  query = Producto.where("empresa", current_user.empresa)
  productos = query.paginate(page, limit).all()
  return json([{
    id: p.id,
    codigo: p.codigo,
    nombre: p.nombre,
    precio: float(p.precio_unitario),
  } for p in productos])
