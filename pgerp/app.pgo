# ═══════════════════════════════════════════════
#  Dashboard
# ═══════════════════════════════════════════════

route GET / -> dashboard
route GET /dashboard -> dashboard

handler dashboard() -> HTML:
  """Analytics dashboard with KPIs."""
  empresa = current_user.empresa_id

  stats = {
    productos: Producto.count(where: {empresa: empresa}),
    clientes: Cliente.count(where: {empresa: empresa}),
    proveedores: Proveedor.count(where: {empresa: empresa}),
    facturas_mes: Factura.count(where: {empresa: empresa, fecha__gte: month_start()}),
    inventario_bajo: Inventario.count(where: {empresa: empresa, "stock_actual < stock_minimo": True}),
    pedidos_activos: Pedido.count(where: {empresa: empresa, estatus: "confirmado"}),
  }

  ingresos_mes = Factura.sum("total", where: {
    empresa: empresa,
    tipo: "venta",
    fecha__gte: month_start(),
  })

  return template("dashboard.html", {
    stats: stats,
    ingresos_mes: ingresos_mes,
    empresa: empresa,
  })


# ═══════════════════════════════════════════════
#  Auth & Security
# ═══════════════════════════════════════════════

route GET /login -> auth.login_page
route POST /login -> auth.authenticate
route POST /logout -> auth.logout

handler login_page() -> HTML:
  return template("auth/login.html")

handler authenticate(email: String, password: String) -> Redirect:
  user = Usuario.where("email", email).where("empresa", empresa_actual.id).first()
  if user and verify_password(user.password_hash, password):
    session.set("user_id", user.id)
    session.set("empresa_id", user.empresa)
    log.info("User logged in", user=user.email)
    return redirect("/dashboard")
  log.warn("Login failed", email=email)
  flash("error", "Credenciales inválidas")
  return redirect("/login")


route POST /logout -> auth.logout
handler logout() -> Redirect:
  session.clear()
  return redirect("/login")


